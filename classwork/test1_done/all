#pragma once

#include <string>
#include "SystemInterface.h"
#include <vector>


class SpecialKeyHandler {
public:
    SpecialKeyHandler() = default;

    // Instead of executing, just inject command into buffer
    virtual bool handleSpecialKey(const check_SKey& key, std::string& inputBuffer);
    virtual ~SpecialKeyHandler() = default;
};



