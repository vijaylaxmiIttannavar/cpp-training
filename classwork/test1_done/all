void ScreenRenderer::redrawBuffer(const std::string& buffer, int cursorPos) {
    SystemInterface::moveCursor(1, 2); // Move to line 2
    std::cout << "\r> " << buffer << " \033[K"; // Clear trailing chars
    SystemInterface::moveCursor(3 + cursorPos, 2);  // Account for "> "
}

void ScreenRenderer::moveCursor(int pos) {
    SystemInterface::moveCursor(3 + pos, 2);
}
